<?xml version="1.0" encoding="utf-8"?>
<com.termux.window.TermuxFloatView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/side_panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ff000000"
    android:orientation="vertical">

    <!-- Tab bar at the top -->
    <com.termux.window.TabBarView
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:background="#ff1a1a1a" />

    <!-- Horizontal container for swipe margin and terminal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left swipe margin - dedicated touch zone for swipe-to-close -->
        <com.termux.window.SwipeMarginView
            android:id="@+id/swipe_margin"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:background="#ff0d0d0d" />

        <!-- Terminal view takes remaining space -->
        <com.termux.view.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollbars="vertical" />

    </LinearLayout>

    <!-- Extra keys row above keyboard -->
    <com.termux.window.ExtraKeysView
        android:id="@+id/extra_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ff1a1a1a" />

</com.termux.window.TermuxFloatView>
